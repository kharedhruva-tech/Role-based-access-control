# ==========================================
# SECURE API GATEWAY WITH RBAC - ENV CONFIG
# ==========================================

# Server Ports
GATEWAY_PORT=5000
BACKEND_PORT=5001
FRONTEND_PORT=5173

# Node Environment
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/secure_rbac_gateway

# JWT Configuration
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_32bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_64bytes
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Backend Service Proxy URL
BACKEND_SERVICE_URL=http://localhost:5001
